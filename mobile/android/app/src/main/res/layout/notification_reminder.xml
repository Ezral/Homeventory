<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed custom content. Samsung owns the app-name header, timestamp,
     and expand chevron. Keep this compact so One UI does not clip it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="0dp"
    android:paddingTop="0dp"
    android:paddingEnd="8dp"
    android:paddingBottom="0dp">

    <TextView
        android:id="@+id/notif_when"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_regular"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAppearance="@style/Homeventory.Notification.Time"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notif_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/notif_photo_fallback"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAppearance="@style/Homeventory.Notification.Title" />

            <TextView
                android:id="@+id/notif_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAppearance="@style/Homeventory.Notification.Body" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
